# 统一换行符，避免 Windows / macOS 协作者之间产生"整文件都变了"的假 diff
* text=auto

*.md      text eol=lf
*.txt     text eol=lf

# Windows 专用脚本必须保留 CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# 二进制文件不做换行符转换
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.zip     binary
*.dmg     binary
*.exe     binary
*.apk     binary
*.ipa     binary
